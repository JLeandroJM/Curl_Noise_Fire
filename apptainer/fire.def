# =============================================================================
# fire.def - Imagen Apptainer con CUDA toolkit + CMake para compilar y correr
# el motor de fuego sin depender de modulos del sistema.
#
# Construir (en una maquina donde seas root o con --fakeroot):
#   apptainer build fire.sif fire.def
#
# Usar en Khipu (la GPU se expone con --nv):
#   apptainer exec --nv fire.sif bash -lc '
#     cmake -S cuda -B cuda/build -DCMAKE_BUILD_TYPE=Release &&
#     cmake --build cuda/build -j4 &&
#     cuda/build/fire_cuda --scene BuildingFire --outdir output/BuildingFire'
# =============================================================================
Bootstrap: docker
From: nvidia/cuda:12.4.1-devel-ubuntu22.04

%post
    export DEBIAN_FRONTEND=noninteractive
    apt-get update
    apt-get install -y --no-install-recommends \
        build-essential cmake git ca-certificates wget
    rm -rf /var/lib/apt/lists/*

%environment
    export PATH=/usr/local/cuda/bin:$PATH
    export LD_LIBRARY_PATH=/usr/local/cuda/lib64:$LD_LIBRARY_PATH

%labels
    Author UTEC-GRAFICA26
    Description "CUDA fire particle simulation (curl noise) build+runtime"

%help
    Contenedor para compilar y ejecutar fire_cuda.
    Requiere --nv al ejecutar para acceder a la GPU NVIDIA del host.
