#version 430 core
layout(local_size_x = 256) in;

#define TYPE_DEAD     0u
#define TYPE_FIRE     1u
#define TYPE_EMBER    2u
#define TYPE_SMOKE    3u
#define TYPE_ASH      4u
#define TYPE_SPARK    5u

#define SHAPE_POINT     0u
#define SHAPE_DISK      1u
#define SHAPE_RECTANGLE 2u
#define SHAPE_LINE      3u
#define SHAPE_SPHERE    4u

struct Particle {
    vec4 position;
    vec4 velocity;
    vec4 color;
    float lifetime;
    float maxLifetime;
    float temperature;
    uint type;
};

layout(std430, binding = 0) buffer ParticleBuffer {
    Particle particles[];
};

struct Emitter {
    vec4 positionAndShape;   // xyz = position, w = shape
    vec4 directionAndRate;   // xyz = direction, w = emitRate
    vec4 dimensions;         // x = width, y = height, z = radius, w = particleLife
    vec4 speedAndTemp;       // x = initialSpeed, y = speedVariance, z = temperature, w = particleSize
};

layout(std430, binding = 1) readonly buffer EmitterBuffer {
    Emitter emitters[];
};

uniform float u_deltaTime;
uniform float u_time;
uniform uint u_maxParticles;
uniform uint u_numEmitters;

uint hash(uint x) {
    x = (x ^ 61u) ^ (x >> 16u);
    x *= 9u;
    x = x ^ (x >> 4u);
    x *= 0x27d4eb2du;
    x = x ^ (x >> 15u);
    return x;
}

float random01(inout uint seed) {
    seed = hash(seed);
    return float(seed) / 4294967295.0;
}

vec3 randomPointInSphere(inout uint seed) {
    float theta = random01(seed) * 6.2831853;
    float z = random01(seed) * 2.0 - 1.0;
    float r = sqrt(max(0.0, 1.0 - z * z));
    float radius = pow(random01(seed), 1.0 / 3.0);

    return vec3(
        radius * r * cos(theta),
        radius * z,
        radius * r * sin(theta)
    );
}

vec3 randomPointInDisk(inout uint seed, float radius) {
    float theta = random01(seed) * 6.2831853;
    float r = sqrt(random01(seed)) * radius;

    return vec3(cos(theta) * r, 0.0, sin(theta) * r);
}

vec3 randomPointInRectangle(inout uint seed, float width, float height) {
    return vec3(
        (random01(seed) - 0.5) * width,
        0.0,
        (random01(seed) - 0.5) * height
    );
}

vec3 randomPointInLine(inout uint seed, float width) {
    return vec3(
        (random01(seed) - 0.5) * width,
        0.0,
        0.0
    );
}

void main() {
    uint index = gl_GlobalInvocationID.x;

    if (index >= u_maxParticles) {
        return;
    }

    if (u_numEmitters == 0u) {
        return;
    }

    Particle oldParticle = particles[index];

    if (oldParticle.type != TYPE_DEAD) {
        return;
    }

    uint seed = index
        ^ floatBitsToUint(u_time * 1000.0)
        ^ 0x9E3779B9u;

    uint emitterIndex = index % u_numEmitters;
    Emitter em = emitters[emitterIndex];

    float emitRate = em.directionAndRate.w;

    // Probabilidad aproximada para emitir emitRate partículas por segundo.
    float particlesPerEmitterPool = float(u_maxParticles) / float(max(u_numEmitters, 1u));
    float probability = clamp((emitRate * u_deltaTime) / particlesPerEmitterPool, 0.0, 1.0);

    if (random01(seed) > probability) {
        return;
    }

    uint shape = uint(em.positionAndShape.w + 0.5);
    vec3 spawnPos = em.positionAndShape.xyz;

    float width = em.dimensions.x;
    float height = em.dimensions.y;
    float radius = em.dimensions.z;
    float particleLife = em.dimensions.w;

    float initialSpeed = em.speedAndTemp.x;
    float speedVariance = em.speedAndTemp.y;
    float temperature = em.speedAndTemp.z;
    float particleSize = em.speedAndTemp.w;

    if (shape == SHAPE_DISK) {
        spawnPos += randomPointInDisk(seed, radius);
    } else if (shape == SHAPE_RECTANGLE) {
        spawnPos += randomPointInRectangle(seed, width, height);
    } else if (shape == SHAPE_LINE) {
        spawnPos += randomPointInLine(seed, width);
    } else if (shape == SHAPE_SPHERE) {
        spawnPos += randomPointInSphere(seed) * radius;
    }

    vec3 dir = normalize(em.directionAndRate.xyz);
    if (length(dir) < 0.0001) {
        dir = vec3(0.0, 1.0, 0.0);
    }

    vec3 noiseDir = vec3(
        random01(seed) - 0.5,
        random01(seed) * 0.5,
        random01(seed) - 0.5
    );

    dir = normalize(dir + noiseDir * 0.35);

    float speed = initialSpeed + (random01(seed) - 0.5) * speedVariance;

    Particle p;
    p.position = vec4(spawnPos, max(particleSize, 0.018));
    p.velocity = vec4(dir * speed, 1.0);

    float r = random01(seed);

    if (r < 0.82) {
        p.type = TYPE_FIRE;
        p.color = vec4(1.0, 0.62, 0.10, 0.92);
        p.temperature = max(temperature, 0.8);
        p.maxLifetime = max(particleLife, 0.75) * (0.70 + random01(seed) * 0.45);
        p.position.w *= 1.25;
    } else if (r < 0.90) {
        p.type = TYPE_SMOKE;
        p.color = vec4(0.34, 0.33, 0.31, 0.18);
        p.temperature = 0.35;
        p.maxLifetime = max(particleLife * 1.05, 1.15);
        p.position.w *= 1.25;
    } else {
        p.type = TYPE_SPARK;
        p.color = vec4(1.0, 0.78, 0.20, 0.80);
        p.temperature = 1.0;
        p.maxLifetime = 0.6 + random01(seed) * 0.5;
        p.position.w *= 0.35;
    }

    p.lifetime = p.maxLifetime;

    particles[index] = p;
}
