#version 430 core
layout(local_size_x = 256) in;

// Inclusión de bibliotecas de ruido
#extension GL_GOOGLE_include_directive : enable
#include "simplex_noise.glsl"
#include "curl_noise.glsl"

// CONSTANTES DE TIPOS DE PARTÍCULA
#define TYPE_DEAD     0u
#define TYPE_FIRE     1u
#define TYPE_EMBER    2u
#define TYPE_SMOKE    3u
#define TYPE_ASH      4u
#define TYPE_SPARK    5u
#define TYPE_PAPER    10u
#define TYPE_CEMENT   11u
#define TYPE_WOOD     12u
#define TYPE_LEAF     13u
#define TYPE_GROUND   14u

// Estructura de la Partícula
struct Particle {
    vec4 position;      // xyz = posición, w = tamaño
    vec4 velocity;      // xyz = velocidad, w = masa
    vec4 color;         // rgba (color y opacidad)
    float lifetime;     // tiempo de vida restante
    float maxLifetime;  // tiempo de vida total
    float temperature;  // nivel de calor (0 a 1)
    uint type;          // tipo de partícula
};

// SSBO: Buffer de Partículas
layout(std430, binding = 0) buffer ParticleBuffer {
    Particle particles[];
};

// Uniforms de física del entorno
uniform float deltaTime;
uniform float currentTime;
uniform vec3 gravity;
uniform float buoyancyStrength;
uniform vec3 windDirection;
uniform float windStrength;

// Color gradient para el fuego
vec4 getFireColor(float temp) {
    // Blanco(1.0) -> Amarillo(0.85) -> Naranja(0.6) -> Rojo(0.3) -> Rojo oscuro(0.15) -> Negro(0.0)
    if (temp > 0.85) return mix(vec4(1.0, 1.0, 0.0, 1.0), vec4(1.0, 1.0, 1.0, 1.0), (temp - 0.85) / 0.15);
    if (temp > 0.6) return mix(vec4(1.0, 0.5, 0.0, 1.0), vec4(1.0, 1.0, 0.0, 1.0), (temp - 0.6) / 0.25);
    if (temp > 0.3) return mix(vec4(1.0, 0.0, 0.0, 1.0), vec4(1.0, 0.5, 0.0, 1.0), (temp - 0.3) / 0.3);
    if (temp > 0.15) return mix(vec4(0.5, 0.0, 0.0, 1.0), vec4(1.0, 0.0, 0.0, 1.0), (temp - 0.15) / 0.15);
    return mix(vec4(0.0, 0.0, 0.0, 1.0), vec4(0.5, 0.0, 0.0, 1.0), temp / 0.15);
}

void main() {
    uint index = gl_GlobalInvocationID.x;
    if (index >= particles.length()) return;

    Particle p = particles[index];
    if (p.type == TYPE_DEAD) return;

    // Disminuir tiempo de vida
    p.lifetime -= deltaTime;
    
    // Si la partícula muere y no es material estático, marcarla como muerta
    if (p.lifetime <= 0.0 && p.type < 10u) {
        p.type = TYPE_DEAD;
        particles[index] = p;
        return;
    }

    vec3 pos = p.position.xyz;
    vec3 vel = p.velocity.xyz;
    float mass = p.velocity.w;
    float age_ratio = clamp(1.0 - (p.lifetime / p.maxLifetime), 0.0, 1.0); // 0 al inicio, 1 al morir

    // Fuerza de viento
    vec3 force = windDirection * windStrength;

    if (p.type == TYPE_FIRE) {
        // Enfriamiento progresivo
        p.temperature -= deltaTime * 0.5;
        p.temperature = max(p.temperature, 0.0);
        
        // Flotabilidad basada en temperatura térmica
        vec3 buoyancy = vec3(0.0, 1.0, 0.0) * buoyancyStrength * p.temperature;
        
        // Ruido Curl para movimiento turbulento tipo fluido
        vec3 curl = curlNoise(pos, currentTime);
        
        vel += (buoyancy + curl * 5.0 + force) * deltaTime;
        pos += vel * deltaTime;
        
        // Actualizar color por temperatura y atenuar alpha
        p.color = getFireColor(p.temperature);
        p.color.a *= (1.0 - age_ratio);
        
    } else if (p.type == TYPE_EMBER) {
        // Movimiento lento y caída ligera con gravedad
        vel += (gravity * 0.2 + force * 0.5) * deltaTime;
        pos += vel * deltaTime;
        
        // Brillo pulsante rojo
        float pulse = sin(currentTime * 10.0 + index) * 0.5 + 0.5;
        p.color = vec4(1.0, 0.2 * pulse, 0.0, 1.0);
        p.color.a *= (1.0 - age_ratio);
        
    } else if (p.type == TYPE_SMOKE) {
        // Humo: Subida lenta, expansión radial y desvanecimiento
        vel += (vec3(0.0, 0.5, 0.0) + force) * deltaTime;
        pos += vel * deltaTime;
        
        p.position.w += deltaTime * 2.0; // Aumentar tamaño progresivamente
        p.color = vec4(0.5, 0.5, 0.5, 1.0); // Gris
        p.color.a *= max(0.0, 1.0 - age_ratio * 1.5); // Desvanecer rápido
        
    } else if (p.type == TYPE_ASH) {
        // Ceniza: Caer con gravedad, deriva aleatoria
        vec3 drift = vec3(snoise(vec3(pos.y * 10.0, currentTime, 0.0)), 0.0, snoise(vec3(0.0, currentTime, pos.y * 10.0)));
        vel += (gravity + drift * 2.0 + force) * deltaTime;
        pos += vel * deltaTime;
        p.color.a *= (1.0 - age_ratio);
        
    } else if (p.type == TYPE_SPARK) {
        // Chispa: Subida rápida, muy caótica
        vec3 curl = curlNoise(pos * 2.0, currentTime * 2.0);
        vel += (vec3(0.0, 2.0, 0.0) * buoyancyStrength + curl * 10.0 + force) * deltaTime;
        pos += vel * deltaTime;
        
        p.color = vec4(1.0, 0.8, 0.2, 1.0); // Amarillo brillante
        p.color.a *= (1.0 - age_ratio);
        
    } else if (p.type >= 10u) {
        // Partículas de material comburente
        float burnStartTime = p.velocity.w;
        if (currentTime > burnStartTime) {
            float phase = (currentTime - burnStartTime) / p.maxLifetime;
            
            if (phase < 0.1) {
                // Calentamiento y Oscurecimiento previo a combustión
                p.color.rgb *= (1.0 - deltaTime * 2.0);
            } else if (phase < 0.4) {
                // Fuego activo: se desprende del material
                p.type = TYPE_FIRE;
                p.temperature = 1.0;
                p.maxLifetime = 2.0;
                p.lifetime = p.maxLifetime;
                p.velocity.w = 1.0; // Restablecer masa
                p.velocity.xyz += vec3(0.0, 1.0, 0.0); // Impulso inicial hacia arriba
            } else if (phase < 0.7) {
                // Fase de brasa
                p.type = TYPE_EMBER;
                p.lifetime = 1.0;
                p.maxLifetime = 1.0;
            } else if (phase < 1.0) {
                // Generación de humo/ceniza
                p.type = TYPE_SMOKE;
                p.lifetime = 2.0;
                p.maxLifetime = 2.0;
            } else {
                p.type = TYPE_DEAD;
            }
        }
    }

    // Fricción / amortiguación general de velocidad
    vel *= 0.99;

    p.position.xyz = pos;
    p.velocity.xyz = vel;
    particles[index] = p;
}
